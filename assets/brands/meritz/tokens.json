{
  "$schema": "../../../config/brand_tokens.schema.json",
  "brand_id": "meritz",
  "brand_name": "Meritz Partners",
  "logo_url": "assets/logos/meritz/logo.png",
  "colors": {
    "primary": "#141414",
    "accent": "#EF3B24",
    "surface": "#FFFFFF",
    "canvas": "#F2F2F2",
    "text_headline": "#141414",
    "text_muted": "#5A5D62",
    "cta_text": "#FFFFFF"
  },
  "typography": {
    "font_family": "Pretendard",
    "font_weights": {
      "regular": 400,
      "semibold": 600,
      "bold": 700,
      "hook": 900
    },
    "letter_spacing": {
      "tight": "-0.04em",
      "normal": "-0.02em",
      "wide": "0em"
    }
  },
  "ui": {
    "cta_radius": "10px",
    "badge_style": "linear_sharp",
    "elevation": {
      "y": 10,
      "blur": 20,
      "opacity": 0.14
    }
  }
}
