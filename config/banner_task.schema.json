{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auto-banner-engine.local/schemas/banner_task.schema.json",
  "title": "Standardized Multi-Brand Banner Task Schema",
  "description": "Strict data contract for standardized multi-aspect ratio performance ad banner tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "content",
    "target_dimensions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z0-9_\\-]+$"
    },
    "brand_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "template": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "logo_url",
        "primary_color",
        "accent_color",
        "bg_color",
        "font_family"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "logo_url": { "type": "string", "minLength": 1 },
        "primary_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "bg_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "font_family": { "type": "string", "minLength": 1 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "badge_text",
        "sub_headline",
        "main_headline",
        "cta_text",
        "cta_style",
        "disclaimers"
      ],
      "properties": {
        "badge_text": { "type": "string" },
        "sub_headline": { "type": "string", "minLength": 1 },
        "main_headline": { "type": "string", "minLength": 1 },
        "hook_visual_asset": { "type": "string" },
        "visual_stage_asset": { "type": "string" },
        "hook_anchor_char": { "type": "string" },
        "cta_text": { "type": "string", "minLength": 1 },
        "cta_style": {
          "type": "string",
          "enum": ["filled_red", "outlined_red", "filled_dark"]
        },
        "disclaimers": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "target_dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "width", "height", "layout_type"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9_\\-]+$" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "layout_type": {
            "type": "string",
            "enum": ["vertical", "square", "wide", "landscape", "micro"]
          }
        }
      }
    }
  }
}
